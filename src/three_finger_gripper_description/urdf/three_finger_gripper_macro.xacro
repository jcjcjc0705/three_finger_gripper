<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- XC330-M288-T, confirm against the datasheet -->
  <xacro:property name="effort" value="0.9"/>
  <xacro:property name="velocity" value="8.0"/>

  <xacro:macro name="three_finger_gripper" params="prefix parent *origin">

    <joint name="${prefix}gripper_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}B_1_Link_001">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/B_1_Link_001.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/B_1_Link_001.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0213859975 -0.00687298198 -0.0232483381" rpy="0 0 0"/>
        <mass value="0.0291661825"/>
        <inertia ixx="7.20609e-06" ixy="1.2944e-06" ixz="1.74384e-06" iyy="1.02433e-05" iyz="-3.53657e-07" izz="9.36077e-06"/>
      </inertial>
    </link>

    <link name="${prefix}A_1_Link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/A_1_Link.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/A_1_Link.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0213937351 -0.00691279659 -0.023253972" rpy="0 0 0"/>
        <mass value="0.0292512811"/>
        <inertia ixx="7.24464e-06" ixy="-1.30422e-06" ixz="-1.74839e-06" iyy="1.02708e-05" iyz="-3.56892e-07" izz="9.40087e-06"/>
      </inertial>
    </link>

    <link name="${prefix}A_2_Link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/A_2_Link.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/A_2_Link.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.000683579376 0.0242542769 -0.0163262462" rpy="0 0 0"/>
        <mass value="0.0313487056"/>
        <inertia ixx="1.34771e-05" ixy="-1.08084e-07" ixz="-1.61903e-08" iyy="3.5956e-06" iyz="-3.73558e-07" izz="1.23227e-05"/>
      </inertial>
    </link>

    <link name="${prefix}A_3_Link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/A_3_Link.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/A_3_Link.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00116539117 0.0164379777 -0.0107974052" rpy="0 0 0"/>
        <mass value="0.0372085667"/>
        <inertia ixx="1.08795e-05" ixy="4.96523e-07" ixz="-6.47648e-09" iyy="3.74104e-06" iyz="-1.16845e-07" izz="9.67821e-06"/>
      </inertial>
    </link>

    <link name="${prefix}C_2_Link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/C_2_Link.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/C_2_Link.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.000683997453 0.0242537812 -0.0156732878" rpy="0 0 0"/>
        <mass value="0.0313462089"/>
        <inertia ixx="1.34761e-05" ixy="1.08016e-07" ixz="-1.6059e-08" iyy="3.59513e-06" iyz="3.73433e-07" izz="1.23218e-05"/>
      </inertial>
    </link>

    <link name="${prefix}C_3_Link_001">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/C_3_Link_001.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/C_3_Link_001.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.00140567783 0.0165544048 0.0108497687" rpy="0 0 0"/>
        <mass value="0.0369930615"/>
        <inertia ixx="1.07474e-05" ixy="-7.39332e-07" ixz="5.12229e-10" iyy="3.74092e-06" iyz="9.40608e-08" izz="9.60972e-06"/>
      </inertial>
    </link>

    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/base_link.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/base_link.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-9.6382706e-07 0.00192450292 0.0387988046" rpy="0 0 0"/>
        <mass value="0.277926738"/>
        <inertia ixx="0.000324604" ixy="-1.25055e-09" ixz="-1.26123e-08" iyy="0.000331234" iyz="-1.50554e-05" izz="0.000346961"/>
      </inertial>
    </link>

    <link name="${prefix}B_3_Link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/B_3_Link.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/B_3_Link.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.00141282959 0.0165297802 -0.0123551695" rpy="0 0 0"/>
        <mass value="0.0370436102"/>
        <inertia ixx="1.07748e-05" ixy="-7.35705e-07" ixz="1.07836e-09" iyy="3.74748e-06" iyz="8.62589e-08" izz="9.63615e-06"/>
      </inertial>
    </link>

    <link name="${prefix}B_2_Link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/B_2_Link.stl"/></geometry>
        <material name="gripper_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://three_finger_gripper_description/meshes/B_2_Link.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.000683628708 0.0242541479 -0.0185737881" rpy="0 0 0"/>
        <mass value="0.0313498415"/>
        <inertia ixx="1.34775e-05" ixy="1.08103e-07" ixz="-1.61905e-08" iyy="3.59573e-06" iyz="3.73609e-07" izz="1.23231e-05"/>
      </inertial>
    </link>

    <!-- motor 1 -->
    <joint name="${prefix}C_2_Joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}C_2_Link"/>
      <origin xyz="-0.0145001631 0.0383998353 0.0770002598" rpy="1.57079977 -1.34284085e-07 -1.57079976"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.221657" upper="1.26013" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- motor 2 -->
    <joint name="${prefix}C_3_Joint" type="revolute">
      <parent link="${prefix}C_2_Link"/>
      <child link="${prefix}C_3_Link_001"/>
      <origin xyz="6.31723492e-07 0.0499998496 -0.0261002724" rpy="1.67177151e-07 -8.07151405e-07 -5.53390475e-07"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.0944" upper="0.644027" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- motor 3 -->
    <joint name="${prefix}A_2_Joint" type="revolute">
      <parent link="${prefix}A_1_Link"/>
      <child link="${prefix}A_2_Link"/>
      <origin xyz="-0.0384004039 -0.0290008044 -0.0390000457" rpy="-1.57079951 0.015708371 -3.14158578"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.499164" upper="1.23744" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- motor 4 -->
    <joint name="${prefix}A_3_Joint" type="revolute">
      <parent link="${prefix}A_2_Link"/>
      <child link="${prefix}A_3_Link"/>
      <origin xyz="1.36339317e-07 0.0499997474 -0.00589972461" rpy="1.58885345e-09 -1.42958947e-07 2.4249211e-07"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-2.0944" upper="0.644027" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- motor 5 -->
    <joint name="${prefix}B_2_Joint" type="revolute">
      <parent link="${prefix}B_1_Link_001"/>
      <child link="${prefix}B_2_Link"/>
      <origin xyz="0.0384001953 -0.0289001111 -0.0389995578" rpy="-1.5707996 7.41566182e-08 -3.14158515"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.499164" upper="1.23744" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- motor 6 -->
    <joint name="${prefix}B_3_Joint" type="revolute">
      <parent link="${prefix}B_2_Link"/>
      <child link="${prefix}B_3_Link"/>
      <origin xyz="-1.93065522e-08 0.0499995561 -0.0057995579" rpy="8.37638333e-09 3.20096406e-07 -3.51844561e-07"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.0944" upper="0.644027" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- motor 7 -->
    <joint name="${prefix}A_1_Joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}A_1_Link"/>
      <origin xyz="0.0295000587 1.39331777e-07 0.0380002526" rpy="-3.14158543 -1.60278625e-07 -3.11366017"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708" upper="1.5708" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- motor 8 -->
    <joint name="${prefix}B_1_Joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}B_1_Link_001"/>
      <origin xyz="-0.0294996344 -6.91998508e-07 0.0380001102" rpy="-3.14158563 -3.55114485e-07 -3.14158514"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708" upper="1.5708" effort="${effort}" velocity="${velocity}"/>
    </joint>

  </xacro:macro>

  <material name="gripper_blue">
    <color rgba="0.15 0.35 0.75 1.0"/>
  </material>

</robot>
