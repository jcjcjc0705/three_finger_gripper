<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Measured on the physical board. The palm mesh shows this sensor board mirrored
       in Y; only that visual is affected. -->
  <xacro:macro name="palm_sensors" params="prefix
                                           board_z:=0.081
                                           camera_offset:=-0.0072">

    <!-- TOF sits at the board centre; mirroring does not move it. -->
    <link name="${prefix}palm_tof"/>
    <joint name="${prefix}palm_tof_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}palm_tof"/>
      <origin xyz="0 0 ${board_z}" rpy="0 0 0"/>
    </joint>

    <!-- Negative Y is away from the thumb. Both frames look along +Z, out of the palm. -->
    <link name="${prefix}palm_camera"/>
    <joint name="${prefix}palm_camera_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}palm_camera"/>
      <origin xyz="0 ${camera_offset} ${board_z}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
